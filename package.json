{
  "name": "nextjs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "sync:repo-stats": "node src/scripts/sync-repo-stats.mjs",
    "sync:community-calls": "node src/scripts/sync-community-calls.mjs",
    "sync:data": "pnpm sync:repo-stats && pnpm sync:community-calls",
    "dev": "pnpm sync:data && next dev",
    "build": "pnpm sync:data && next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "update-snap": "vitest run --update",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json}\""
  },
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.7",
    "date-fns": "^4.4.0",
    "js-yaml": "^5.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swiper": "^14.4.0",
    "toml": "^5.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.4",
    "fast-check": "4.10.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  }
}
